    "def wrapper(func):\n",
    "    def fn2():\n",
    "        print('ts happened')\n",
    "        func()\n",
    "        print('now ts happen')\n",
    "    return fn2\n",
    "\n",
    "@wrapper\n",
    "def howdy():\n",
    "    print(\"howdy\")\n",
    "howdy()"
